{% extends 'base.html.twig' %}

{% block title %}{{ titre_page }}{% endblock %}

{% block body %}
<style>
    /*CSS*/
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f6f9; padding: 20px; }
    .dashboard-container { max-width: 1200px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    h1 { color: #2c3e50; border-bottom: 2px solid #e74c3c; padding-bottom: 10px; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 14px; }
    th, td { padding: 12px; border: 1px solid #ddd; text-align: left; }
    th { background-color: #2c3e50; color: white; }
    tr:nth-child(even) { background-color: #f9f9f9; }

.btn-relancer {
    display: inline-block;
    margin-left: 10px;
    padding: 2px 8px;
    background-color: #34495e;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-size: 12px;
}
.btn-relancer:hover { background-color: #2c3e50; cursor: pointer; }

    /* Couleurs des statuts */
    .badge { padding: 5px 10px; border-radius: 4px; font-weight: bold; color: white; }
    .bg-success { background-color: #27ae60; }
    .bg-error { background-color: #c0392b; }
    .bg-wait { background-color: #f39c12; }
</style>

<div class="dashboard-container">
    <h1>📊 {{ titre_page }}</h1>


    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Type de Flux</th>
                <th>Statut</th>
                <th>Détail / Message d'erreur</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for flux in flux_data %}
                <tr>
                    <td>{{ flux.createdAt|date('d/m/Y H:i') }}</td>

                    <td>{{ flux.typeFlux }}</td>

                    <td>
                        {% if flux.statut == 'Succès' %}
                            <span class="badge bg-success">OK</span>
                        {% elseif flux.statut == 'Erreur' %}
                            <span class="badge bg-error">ERREUR</span>
                        {% else %}
                            <span class="badge bg-wait">EN ATTENTE</span>
                        {% endif %}
                    </td>

                    <td>{{ flux.messageErreur|default('-') }}</td>

                    <td>
                        {% if flux.statut == 'Erreur' %}
                            <a href="{{ path('app_traiter_flux', {'id': flux.id}) }}" class="btn-relancer">Relancer</a>
                        {% else %}
                            -
                        {% endif %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" style="text-align: center;">Aucun flux enregistré dans la base.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}

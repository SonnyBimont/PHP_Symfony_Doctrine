{% extends 'base.html.twig' %}

{% block title %}Hello HelloController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ clients[0].nom }} {{ clients[0].mail }}, né le {{ clients[0].dateNaissance|date('d/m/Y') }} </h1>

{# Affichage conditionnel basé sur l'année de naissance du client#}
{% if clients[0].dateNaissance|date('Y') < 1990 %}
    <p>Vous êtes né avant l'an 2000.</p>
{% elseif clients[0].dateNaissance|date('Y') == 1990 %}
    <p>Vous êtes né en l'an 2000.</p>
{% else %}
    <p>Vous êtes né après l'an 2000.</p>
{% endif %}

{#Affichage de tous les clients #}
{%for client in clients %}
    <p>{{ client.nom }} - {{ client.mail }} - {{ client.dateNaissance|date('d/m/Y') }}</p>
{% endfor %}


</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Hello HelloController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ client.nom }} </h1>
    <p>mail : {{ client.mail }}, né le {{ client.dateNaissance|date('d/m/Y') }} </p>

<p>{{client.nom}} a acheté {{ commandes[0].quantite }} {{ commandes[0].produits}} de la marque {{ commandes[0].marque }} </p>

</div>
{% endblock %}
